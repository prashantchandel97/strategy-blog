# Strategy Blog Publisher — Environment Variables
# Copy this file to .env and fill in the values

# ── Blog API ──────────────────────────────────
# API key from your website's Vercel env (N8N_API_KEY)
N8N_API_KEY=your_n8n_api_key_here

# Blog endpoint (default is production; change for local testing)
BLOG_API_URL=https://www.prashant-chandel.org/api/n8n/posts

# ── Twitter / X ───────────────────────────────
# Get these from developer.twitter.com → Your App → Keys and Tokens
# App must have READ + WRITE permissions
TWITTER_CONSUMER_KEY=your_api_key
TWITTER_CONSUMER_SECRET=your_api_key_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
